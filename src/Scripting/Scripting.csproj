<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AxiomPlayground.Scripting</RootNamespace>
  </PropertyGroup>

  <!-- Dev configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Dev'">
    <DefineConstants>DEV_ENV;TRACE</DefineConstants>
    <OutputPath>../../lib/Dev/</OutputPath>
  </PropertyGroup>

  <!-- Release configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>../../lib/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modding/Modding.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Data/Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Localization/Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>../../lib/Dev/net10.0/MoonSharp.Interpreter.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="LuaLib\**\*.lua" />
  </ItemGroup>

</Project>
